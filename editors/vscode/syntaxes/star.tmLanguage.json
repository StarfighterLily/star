{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Star",
  "scopeName": "source.star",
  "fileTypes": ["star"],
  "patterns": [{ "include": "#expression" }],
  "repository": {
    "expression": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#decorators" },
        { "include": "#fstrings" },
        { "include": "#strings" },
        { "include": "#chars" },
        { "include": "#numbers" },
        { "include": "#keywords-control" },
        { "include": "#keywords-concurrency" },
        { "include": "#keywords-operator-word" },
        { "include": "#keywords-other" },
        { "include": "#storage-types" },
        { "include": "#constants-language" },
        { "include": "#self" },
        { "include": "#wildcard" },
        { "include": "#definitions" },
        { "include": "#primitive-types" },
        { "include": "#named-types" },
        { "include": "#function-calls" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.star",
          "match": "#.*$"
        }
      ]
    },

    "decorators": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.star",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },

    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.star",
          "match": "\\\\[ntr\\\\\"'0{}]"
        },
        {
          "name": "invalid.illegal.unknown-escape.star",
          "match": "\\\\."
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.star",
          "begin": "\"",
          "end": "\"|(?<!\\\\)$",
          "patterns": [{ "include": "#string-escapes" }]
        }
      ]
    },

    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.star",
          "begin": "'",
          "end": "'|(?<!\\\\)$",
          "patterns": [{ "include": "#string-escapes" }]
        }
      ]
    },

    "fstrings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.star",
          "begin": "f\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.star" }
          },
          "end": "\"|(?<!\\\\)$",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.star" }
          },
          "patterns": [
            { "include": "#interpolation" },
            { "include": "#string-escapes" }
          ]
        }
      ]
    },

    "interpolation": {
      "name": "meta.interpolation.star",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.star" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.star" }
      },
      "patterns": [
        { "include": "#fstrings" },
        { "include": "#strings" },
        { "include": "#chars" },
        { "include": "#numbers" },
        { "include": "#keywords-control" },
        { "include": "#keywords-concurrency" },
        { "include": "#keywords-operator-word" },
        { "include": "#keywords-other" },
        { "include": "#storage-types" },
        { "include": "#constants-language" },
        { "include": "#self" },
        { "include": "#wildcard" },
        { "include": "#primitive-types" },
        { "include": "#named-types" },
        { "include": "#function-calls" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.star",
          "match": "(?<!\\.)\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.star",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.star",
          "match": "\\b(if|else|for|in|while|break|continue|return|match|yield)\\b"
        }
      ]
    },

    "keywords-concurrency": {
      "patterns": [
        {
          "name": "keyword.control.concurrency.star",
          "match": "\\b(frame|arena|swarm|par|each|sequence|spawn|despawn|system|parallel)\\b"
        }
      ]
    },

    "keywords-operator-word": {
      "patterns": [
        {
          "name": "keyword.operator.word.star",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },

    "keywords-other": {
      "patterns": [
        {
          "name": "keyword.other.star",
          "match": "\\b(let|const|mut|import|as|extern)\\b"
        }
      ]
    },

    "storage-types": {
      "patterns": [
        {
          "name": "storage.type.star",
          "match": "\\b(struct|trait|enum|impl|fn)\\b"
        }
      ]
    },

    "constants-language": {
      "patterns": [
        {
          "name": "constant.language.boolean.star",
          "match": "\\b(true|false)\\b"
        }
      ]
    },

    "self": {
      "patterns": [
        {
          "name": "variable.language.self.star",
          "match": "\\bself\\b"
        }
      ]
    },

    "wildcard": {
      "patterns": [
        {
          "name": "keyword.other.wildcard.star",
          "match": "\\b_\\b"
        }
      ]
    },

    "primitive-types": {
      "patterns": [
        {
          "name": "support.type.primitive.star",
          "match": "\\b(i8|u8|i16|u16|i32|u32|i64|u64|f32|f64|int|float|bool|char|str|String|ptr)\\b"
        }
      ]
    },

    "definitions": {
      "patterns": [
        {
          "match": "\\b(struct|trait|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.star" },
            "2": { "name": "entity.name.type.star" }
          }
        },
        {
          "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(for)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "storage.type.star" },
            "2": { "name": "entity.name.type.star" },
            "3": { "name": "keyword.other.star" },
            "4": { "name": "entity.name.type.star" }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.star" },
            "2": { "name": "entity.name.function.star" }
          }
        },
        {
          "match": "\\b(system)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.concurrency.star" },
            "2": { "name": "entity.name.function.star" }
          }
        },
        {
          "match": "\\b(arena)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.concurrency.star" },
            "2": { "name": "entity.name.type.star" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.star" },
            "2": { "name": "variable.other.constant.star" }
          }
        }
      ]
    },

    "named-types": {
      "patterns": [
        {
          "name": "entity.name.type.star",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.star",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.star",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.range.star",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.star",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.star",
          "match": "\\+=|-=|\\*=|/=|="
        },
        {
          "name": "keyword.operator.logical.star",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.arithmetic.star",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.other.star",
          "match": "!|@|\\?"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.accessor.double-colon.star",
          "match": "::"
        },
        {
          "name": "punctuation.accessor.star",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.star",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.star",
          "match": ","
        },
        {
          "name": "punctuation.separator.semicolon.star",
          "match": ";"
        },
        {
          "name": "punctuation.section.parens.star",
          "match": "\\(|\\)"
        },
        {
          "name": "punctuation.section.brackets.star",
          "match": "\\[|\\]"
        },
        {
          "name": "punctuation.section.braces.star",
          "match": "\\{|\\}"
        }
      ]
    }
  }
}
