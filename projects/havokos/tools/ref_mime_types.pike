// Generates mimetypes.star (todo.md HavokOS P1 #8): the extension -> media
// type table behind the reference's HTTP port, Pike's own
// MIME.ext_to_media_type (what Protocols.HTTP.Server.filename_to_type()
// looks extensions up in), so a mudlib file sent over HTTP gets the type
// the reference gives it.
//
//   pike tools/ref_mime_types.pike > mimetypes.star

int main() {
    mapping(string:string) m = (mapping)MIME.ext_to_media_type;
    array(string) exts = sort(indices(m));
    write("# GENERATED by tools/ref_mime_types.pike from the live reference's Pike\n");
    write("# (MIME.ext_to_media_type, %d extensions) -- do not edit by hand.\n", sizeof(exts));
    write("#\n");
    write("# The media type of a lower-cased file extension, as the reference's HTTP\n");
    write("# port gives a mudlib file it sends (http.star; Pike's\n");
    write("# Protocols.HTTP.Server.filename_to_type()): built once into a Map, an\n");
    write("# unknown extension is application/octet-stream.\n\n");
    write("fn mime_table() -> Map<str, str>:\n");
    write("    let mut m: Map<str, str> = Map<str, str>()\n");
    // each through the lookup itself: its small table wins over the big one
    foreach (exts, string e) write("    m.insert(%q, %q)\n", e, MIME.ext_to_media_type(e));
    write("    m\n");
    return 0;
}
