// Generates efun_names.star (todo.md HavokOS M3) from the live reference:
// the efuns HavokOS implements (`efuns->implemented()`, what the emitter's
// `efun_names` holds) and every FluffOS efun name (lpc/fluffos_efuns.txt,
// the emitter's `known_efuns`). The Star compiler resolves a call by name in
// the emitter's order (own/inherited function, simul_efun, function
// variable, efun), and both sets take part in that decision, so they're
// copied from the reference rather than re-typed.
//
//   pike ref_efun_names.pike <havokos_pike_dir> > ../efun_names.star

int main(int argc, array(string) argv) {
    string pd = argv[1];
    mapping cfg = ([ "name": "HavokTest", "master file": "/secure/master",
        "simulated efun file": "/secure/sefun", "include directories": "/include",
        "global include file": "<global.h>", "port": "6699" ]);
    object drv = compile_file(pd + "/havok/driver.pike")(pd + "/tests/minilib", cfg);
    array(string) impl = sort(indices(drv->efuns->implemented()));
    array(string) known = sort(map(Stdio.read_file(pd + "/lpc/fluffos_efuns.txt") / "\n",
                                   String.trim_all_whites) - ({ "" }));
    write("# Generated by tools/ref_efun_names.pike from the live HavokOS reference;\n"
          "# do not edit by hand. See that script for why these lists exist.\n\n");
    foreach (({ ({ "reference_efuns", impl }), ({ "fluffos_efuns", known }) }), array l) {
        write("fn %s() -> List<str>:\n    [", l[0]);
        foreach (l[1]; int i; string n) {
            if (i) write(",");
            write(i % 8 == 0 ? "\n        " : " ");
            write("%O", n);
        }
        write("]\n\n");
    }
    return 0;
}
